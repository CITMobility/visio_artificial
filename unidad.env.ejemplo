# =============================================================================
# CIT Mobility :: configuracion de la unidad para cit.sh (v5, ADR-001)
#
# Copiar como unidad.env y llenar. unidad.env esta en .gitignore porque lleva
# contrasenas; este .ejemplo si va al repositorio y no lleva ninguna.
#
#     cp unidad.env.ejemplo unidad.env
#     chmod 600 unidad.env
# =============================================================================

# --- Identidad (tabla 3 del ADR-001) -----------------------------------------
UNIDAD_ID=cit-001            # device_id: el MODULO. Tambien nombre del flujo de video
VEHICULO_ID=                 # vehicle_id: camion donde esta instalado hoy el modulo
UNIDAD="Ruta A-01"           # nombre legible, solo para la consola

# --- VM: telemetria y comandos por MQTT --------------------------------------
# Sin VM_HOST no se envia nada a la VM y no se aceptan comandos.
VM_HOST=                     # IP publica o nombre de la VM
VM_MQTT_PUERTO=8883
VM_MQTT_TLS=1                # el ADR exige TLS. 0 (con puerto 1883) solo en banco
VM_MQTT_CA=                  # CA propia de la VM; vacio = las del sistema (Let's Encrypt)
VM_MQTT_CERT=                # solo si la VM usa TLS mutuo (certificado del equipo)
VM_MQTT_LLAVE=
VM_MQTT_USUARIO=cit-001      # credencial propia de ESTE equipo (una por dispositivo)
VM_MQTT_CONTRASENA=

# --- VM: video por SRT hacia MediaMTX ----------------------------------------
VM_SRT_PUERTO=8890
VM_SRT_PASSPHRASE=           # 10 a 79 caracteres; vacio = video sin cifrar
# Como se anuncia ante MediaMTX. Con usuario: publish:cit-001:usuario:contrasena
VM_SRT_STREAMID=publish:cit-001

# --- Video (lo hace cumplir el contador, no la VM) ---------------------------
FPS_VIDEO=8
BITRATE=400                  # kbps, tope del H.264
VENTANA_S=60                 # duracion maxima de una sesion; tope duro 60
TOPE_SESIONES_MES=100        # PROVISIONAL: la cifra la fija Direccion general

# --- Comandos ---------------------------------------------------------------
# Reinicios (app.restart + module.restart) por hora. 0 = sin limite (pruebas).
CIT_MAX_REINICIOS_HORA=3

# --- AWS IoT Core (de reserva, apagado; no tocar) ----------------------------
ENVIAR_AWS=0                 # 1 para enviar tambien a AWS, como antes
CIT_BROKER=a3g1b4rvksirbn-ats.iot.us-east-1.amazonaws.com

# --- Modo anterior -----------------------------------------------------------
# CONTADOR=contador_p2p_v15.py y TUNEL=1 vuelven a la pagina MJPEG por tunel.
CONTADOR=contador_p2p_v17.py
TUNEL=0
